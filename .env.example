# Runtime
NODE_ENV=development
PORT=3000

# Supabase (Product DB) — get from project settings
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# Brain server (friend's mevzuat-knowledge-api)
# Local dev: http://127.0.0.1:8000   Production (Railway internal): http://mevzuat-knowledge-api.railway.internal:PORT
# Use 127.0.0.1 not "localhost" — Node's undici on macOS resolves localhost → ::1 (IPv6) first,
# but uvicorn binds IPv4 only. This causes silent hangs on chat requests.
BRAIN_API_URL=http://127.0.0.1:8000
BRAIN_API_KEY=change-me
BRAIN_TIMEOUT_MS=300000

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Credits
SIGNUP_BONUS_CREDITS=500
